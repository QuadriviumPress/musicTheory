{
  "name": "open-music-theory-myst",
  "version": "1.0.0",
  "private": true,
  "description": "The MyST Markdown edition of Open Music Theory.",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "npm": ">=10 <11"
  },
  "scripts": {
    "start": "myst start",
