{
  "name": "open-music-theory-myst",
  "version": "1.0.0",
  "private": true,
  "description": "The MyST Markdown edition of Open Music Theory.",
  "license": "MIT",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26",
    "npm": ">=11 <12"
  },
  "scripts": {
    "start": "myst start",
    "build": "myst build --html && node scripts/setup-pwa.mjs",
    "verify": "node scripts/verify-book.mjs",
    "check": "npm run verify && myst build --html --strict --check-links"
  },
  "devDependencies": {
    "mystmd": "1.12.0",
    "sharp": "0.35.5",
    "yaml": "2.9.1"
  }
}
